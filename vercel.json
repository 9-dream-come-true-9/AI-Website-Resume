{
  "functions": {
    "api/chat.js": {
      "includeFiles": "api/assistant-knowledge-base.md",
      "maxDuration": 60
    },
    "api/download-resume.js": {
      "includeFiles": "assets/resume/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
